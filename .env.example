# SMTP Configuration for Contact Form (Nodemailer)
# Example using Gmail: host=smtp.gmail.com, port=587, secure=false
# For Gmail, use an App Password (not your regular password):
# https://support.google.com/accounts/answer/185833

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# The email address that will receive contact form submissions
CONTACT_EMAIL_TO=recipient@gmail.com
